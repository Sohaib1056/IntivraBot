# ── AI Service ─────────────────────────────────────────
PORT=8000
# Comma-separated origins allowed to call this service (the Node backend).
ALLOWED_ORIGINS=http://localhost:5000

# Gemini (Phase 4 — AI interviews). Get a free key: https://aistudio.google.com/apikey
# Leave blank to run interviews in offline fallback mode (question bank + heuristic scoring).
GEMINI_API_KEY=
# Pin a real model id rather than a '-latest' alias: the alias can resolve to an
# overloaded model that 503s on every call, which silently drops interviews to
# the offline question bank. Used when the primary is unavailable:
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Groq (free, no card) — tried when every Gemini model fails, before giving up
# to the offline question bank. Gemini's free tier allows only 20 requests/day
# per model and a spent *daily* quota does not clear, so without this a single
# afternoon of testing leaves later interviews asking generic questions.
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
# Groq rotates its free catalogue — list what a key can actually reach with
# GET https://api.groq.com/openai/v1/models if questions start coming from the
# offline bank. Text only: image checks stay on Gemini by design.
GROQ_MODEL=openai/gpt-oss-120b
